  "switch": {"name": "switching the gate within a reply", "eval": "chat/switch_p4p2.json", "writers": ["p4", "p2"],
             "reported": {"p4": {"precision": 0.975, "recall": 0.809, "ifeval": -3.9, "gsm8k": -36.8},
