{
  "source": "The dialogue fine-tunes of the chat stream (polyformer-wt/chat research/sketch/chat/CHAT3.md at 621940ab). Every value is recomputed by fig5.py from the eval files copied unchanged into data/chat/ (out/p1..p9/eval_p*.json, out/eval_stock*.json, out/sw/switch_p4p2.json) and checked against the reported values below (CHAT3.md; the paper's Extended Data Table 'Dialogue fine-tuning'). Points are against the base model zero-shot (IFEval strict prompt-level, GSM8K 250 with the sheet run by a Python stand-in, MMLU 500); invocation is on the 780 held-out items, the base model with four examples.",
  "criterion": {"points": -2.0, "invocation": 0.95},
  "base": {"name": "base model, four examples", "eval": "chat/eval_stock.json", "fewshot": "chat/eval_stock_fewshot.json"},
  "runs": [
    {"id": "P1", "recipe": "synthetic dialogues, self-distillation (multiplier adapter)", "eval": "chat/eval_p1.json",
     "reported": {"precision": 0.957, "recall": 0.996, "ifeval": -4.8, "gsm8k": null, "mmlu": -6.6}},
    {"id": "P2", "recipe": "synthetic dialogues, self-distillation", "eval": "chat/eval_p2.json",
     "reported": {"precision": 1.000, "recall": 0.998, "ifeval": -0.55, "gsm8k": -31.2, "mmlu": -5.4}},
    {"id": "P3", "recipe": "+ human multi-step solutions", "eval": "chat/eval_p3.json",
     "reported": {"precision": 1.000, "recall": 0.994, "ifeval": -2.8, "gsm8k": -14.0, "mmlu": -2.4}},
    {"id": "P4", "recipe": "+ base-model multi-step solutions", "eval": "chat/eval_p4.json",
     "reported": {"precision": 1.000, "recall": 0.994, "ifeval": -4.4, "gsm8k": -6.4, "mmlu": -3.4}},
    {"id": "P5", "recipe": "+ on-policy distillation", "eval": "chat/eval_p5.json",
     "reported": {"precision": 1.000, "recall": 0.946, "ifeval": -1.5, "gsm8k": -2.0, "mmlu": -2.2}},
    {"id": "P6", "recipe": "+ wider word-problem data", "eval": "chat/eval_p6.json",
     "reported": {"precision": 1.000, "recall": 0.991, "ifeval": 0.2, "gsm8k": -2.4, "mmlu": -2.2}},
    {"id": "P7", "recipe": "+ GRPO", "eval": "chat/eval_p7.json",
     "reported": {"precision": 1.000, "recall": 0.981, "ifeval": -2.0, "gsm8k": -4.8, "mmlu": -0.6}},
    {"id": "P8", "recipe": "+ GRPO, strict reward and task mix", "eval": "chat/eval_p8.json",
