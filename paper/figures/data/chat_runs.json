    {"id": "P9", "recipe": "+ GRPO anchored to the supervised checkpoint", "final": true, "eval": "chat/eval_p9.json",
     "reported": {"precision": 0.994, "recall": 0.989, "ifeval": -1.5, "gsm8k": -1.6, "mmlu": -1.4}}
