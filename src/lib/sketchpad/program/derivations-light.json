[
	{
		"source": "solve 3(x-2)+5=2x+14",
		"lines": [
			{ "kind": "given", "tex": "3\\left(x - 2\\right) + 5 = 2x + 14" },
			{ "kind": "expand", "tex": "3x - 3\\cdot 2 + 5 = 2x + 14" },
			{
				"kind": "evaluate",
				"tex": "3x - 6 + 5 = 2x + 14",
				"note": "-\\left(3\\cdot 2\\right) = -6"
			},
			{ "kind": "collect", "tex": "3x - 1 = 2x + 14", "note": "-6 + 5 = -1" },
			{ "kind": "move", "tex": "3x - 2x = 14 + 1" },
			{ "kind": "collect", "tex": "x = 15", "note": "3 - 2 = 1,\\quad 14 + 1 = 15" },
			{
				"kind": "check",
				"tex": "15 - 15 = 0\\quad\\checkmark",
				"note": "Substitute into the collected equation"
			},
			{ "kind": "result", "tex": "x = 15" }
		]
	},
	{
		"source": "solve x^2-x-6=0",
		"lines": [
			{ "kind": "given", "tex": "x^{2} - x - 6 = 0" },
			{
				"kind": "formula",
				"tex": "\\left(-1\\right)^{2} - 4\\cdot 1\\cdot \\left(-6\\right) = 25",
				"note": "Discriminant: b² − 4ac"
			},
			{ "kind": "formula", "tex": "\\sqrt{25} = 5" },
			{ "kind": "divide", "tex": "x = \\frac{1 - 5}{2\\cdot 1} = -2" },
			{ "kind": "divide", "tex": "x = \\frac{1 + 5}{2\\cdot 1} = 3" },
			{
				"kind": "check",
				"tex": "\\left(-2\\right)^{2} + 2 - 6 = 0\\quad\\checkmark",
				"note": "Substitute into the collected equation"
			},
			{
				"kind": "check",
				"tex": "3^{2} - 3 - 6 = 0\\quad\\checkmark",
				"note": "Substitute into the collected equation"
			},
			{ "kind": "result", "tex": "x = -2,\\;3" }
		]
	},
	{
		"source": "expand (x+2)^5",
		"lines": [
			{ "kind": "given", "tex": "\\left(x + 2\\right)^{5}" },
			{
				"kind": "expand",
				"tex": "\\left(x + 2\\right)^{5} = x^{5} + 5\\cdot 2x^{4} + 10\\cdot 2^{2}x^{3} + 10\\cdot 2^{3}x^{2} + 5\\cdot 2^{4}x + 2^{5}",
				"note": "Binomial theorem; coefficients from Pascal's additions"
			},
			{
				"kind": "evaluate",
				"tex": "x^{5} + 5\\cdot 2x^{4} + 10\\cdot 2^{2}x^{3} + 10\\cdot 2^{3}x^{2} + 5\\cdot 2^{4}x + 2^{5} = x^{5} + 5\\cdot 2x^{4} + 10\\cdot 4x^{3} + 10\\cdot 8x^{2} + 5\\cdot 16x + 32",
				"note": "Evaluate the powers"
			},
			{
				"kind": "evaluate",
				"tex": "x^{5} + 5\\cdot 2x^{4} + 10\\cdot 4x^{3} + 10\\cdot 8x^{2} + 5\\cdot 16x + 32 = x^{5} + 10x^{4} + 40x^{3} + 80x^{2} + 80x + 32",
				"note": "Multiply the coefficients"
			},
			{
				"kind": "check",
				"tex": "\\left(1 + 2\\right)^{5} = 243 = 1^{5} + 10\\cdot 1^{4} + 40\\cdot 1^{3} + 80\\cdot 1^{2} + 80\\cdot 1 + 32\\quad\\checkmark",
				"note": "Check at x = 1"
			},
			{
				"kind": "result",
				"tex": "\\left(x + 2\\right)^{5} = x^{5} + 10x^{4} + 40x^{3} + 80x^{2} + 80x + 32"
			}
		]
	},
	{
		"source": "solve 2x+3y=7,x-y=1",
		"lines": [
			{ "kind": "given", "tex": "2x + 3y = 7" },
			{ "kind": "given", "tex": "x - y = 1" },
			{ "kind": "evaluate", "tex": "2x - 2y = 2", "note": "Multiply equation 2 by 2" },
			{
				"kind": "move",
				"tex": "2x + 3y - \\left(2x - 2y\\right) = 7 - 2",
				"note": "Subtract the scaled equation 2 from the scaled equation 1"
			},
			{ "kind": "collect", "tex": "5y = 5" },
			{ "kind": "divide", "tex": "y = 1" },
			{
				"kind": "evaluate",
				"tex": "2x + 3\\cdot 1 = 7",
				"note": "Back-substitute the known values"
			},
			{ "kind": "move", "tex": "2x = 7 - 3" },
			{ "kind": "evaluate", "tex": "2x = 4" },
			{ "kind": "divide", "tex": "x = 2" },
			{ "kind": "check", "tex": "2\\cdot 2 + 3\\cdot 1 = 7\\quad\\checkmark" },
			{ "kind": "check", "tex": "2 - 1 = 1\\quad\\checkmark" },
			{ "kind": "result", "tex": "x = 2,\\quad y = 1" }
		]
	},
	{
		"source": "factor x^3-6x^2+11x-6",
		"lines": [
			{ "kind": "given", "tex": "x^{3} - 6x^{2} + 11x - 6" },
			{
				"kind": "formula",
				"tex": "\\text{Candidates: } 1,\\;-1,\\;2,\\;-2,\\;3,\\;-3,\\;6,\\;-6",
				"note": "Rational root theorem: numerator divides the constant, denominator divides the leading coefficient"
			},
			{
				"kind": "evaluate",
				"tex": "1^{3} - 6\\cdot 1^{2} + 11\\cdot 1 - 6 = 0",
				"note": "A root: continue with synthetic division"
			},
			{
				"kind": "divide",
				"tex": "\\begin{array}{r|rrrr}1&1&-6&11&-6\\\\ & &1&-5&6\\\\\\hline &1&-5&6&0\\end{array}",
				"note": "Synthetic division"
			},
			{
				"kind": "divide",
				"tex": "x^{3} - 6x^{2} + 11x - 6 = \\left(x - 1\\right)\\left(x^{2} - 5x + 6\\right)",
				"note": "Zero remainder proves the factor"
			},
			{
				"kind": "check",
				"tex": "1^{3} - 6\\cdot 1^{2} + 11\\cdot 1 - 6 = 0\\quad\\checkmark",
				"note": "Substitute into the collected equation"
			},
			{
				"kind": "formula",
				"tex": "\\left(-5\\right)^{2} - 4\\cdot 1\\cdot 6 = 1",
				"note": "Discriminant: b² − 4ac"
			},
			{ "kind": "formula", "tex": "\\sqrt{1} = 1" },
			{ "kind": "divide", "tex": "x = \\frac{5 - 1}{2\\cdot 1} = 2" },
			{ "kind": "divide", "tex": "x = \\frac{5 + 1}{2\\cdot 1} = 3" },
			{
				"kind": "divide",
				"tex": "\\begin{array}{r|rrr}2&1&-5&6\\\\ & &2&-6\\\\\\hline &1&-3&0\\end{array}",
				"note": "Synthetic division"
			},
			{
				"kind": "divide",
				"tex": "x^{2} - 5x + 6 = \\left(x - 2\\right)\\left(x - 3\\right)",
				"note": "Zero remainder proves the factor"
			},
			{
				"kind": "check",
				"tex": "2^{3} - 6\\cdot 2^{2} + 11\\cdot 2 - 6 = 0\\quad\\checkmark",
				"note": "Substitute into the collected equation"
			},
			{
				"kind": "check",
				"tex": "3^{3} - 6\\cdot 3^{2} + 11\\cdot 3 - 6 = 0\\quad\\checkmark",
				"note": "Substitute into the collected equation"
			},
			{
				"kind": "result",
				"tex": "x^{3} - 6x^{2} + 11x - 6 = \\left(x - 1\\right)\\left(x - 2\\right)\\left(x - 3\\right)"
			}
		]
	}
]
